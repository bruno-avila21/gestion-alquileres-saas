# Copiar a .env (está git-ignorado) y completar.
#
#   cp .env.example .env
#
# Los dos secretos son OBLIGATORIOS y tienen que medir 32 caracteres o más, o la aplicación
# no arranca. Generar cada uno por separado:
#
#   openssl rand -base64 48
#
JWT_SECRET=
DOCUMENT_TOKEN_SECRET=

# ── Local ─────────────────────────────────────────────────────────────────────
# Con esto alcanza para `docker compose up -d --build`. Todo lo demás tiene default.
POSTGRES_PASSWORD=devpassword
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ── Servicio de índices ICL / IPC ─────────────────────────────────────────────
# Vive en otro repositorio. Sin él falla la proyección de ajustes; el resto anda.
# Si lo corrés en tu máquina fuera de Docker, host.docker.internal apunta al host.
INDICES_API_URL=http://host.docker.internal:5000
INDICES_API_KEY=

# ── Email ─────────────────────────────────────────────────────────────────────
# "Null" NO envía nada, sólo loguea. Para probar los avisos de verdad, poner Smtp
# y completar el resto.
EMAIL_PROVIDER=Null
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=no-reply@localhost

# ── Sólo para el VPS (docker-compose.prod.yml) ────────────────────────────────
# Dominio público. Caddy saca el certificado TLS contra este nombre, así que el
# registro A tiene que estar apuntando al servidor ANTES de levantar el stack.
# SITE_ADDRESS=alquilar.tudominio.com
# PUBLIC_URL=https://alquilar.tudominio.com
# ALLOWED_HOSTS=alquilar.tudominio.com
#
# Registro. En Producción la app NO arranca con "Open". Poné InviteCode con un código
# secreto (así sembrás la primera org y nadie más se registra), o Disabled para cerrarlo.
# REGISTRATION_MODE=InviteCode
# REGISTRATION_INVITE_CODE=<un código largo y secreto>
#
# En el VPS, además, el POSTGRES_PASSWORD y las credenciales de MinIO de arriba NO pueden
# quedar en los valores de desarrollo: cambialos por credenciales fuertes.

# ─── Soporte del producto ───
# A dónde escribe la inmobiliaria desde /admin/soporte. Son datos de quien opera la
# plataforma, no de la inmobiliaria. Si quedan vacíos, la pantalla avisa que no hay
# canal configurado en lugar de mostrar un enlace que no lleva a ningún lado.
# VITE_SUPPORT_EMAIL=soporte@tu-dominio.com
# VITE_SUPPORT_WHATSAPP=5491100000000
